# Your Anthropic API key (platform.claude.com → API keys). Never commit .env.
ANTHROPIC_API_KEY=

# Only needed if your key isn't tied to a workspace: the wrkspc_… ID from the Console.
ANTHROPIC_WORKSPACE_ID=

# Model for the agent. claude-sonnet-5 is the default: in the model lab it matched Opus on account
# sorting for about 60% of the price. Use claude-opus-5-5 if your lab shows Sonnet missing traps.
MODEL=claude-sonnet-5

# When it runs: a cron line (minute hour day-of-month month day-of-week) in your time zone.
#   0 8 * * 1-5   every weekday at 08:00
#   0 8 * * 1     every Monday at 08:00
#   0 9 * * 2,4   Tuesdays and Thursdays at 09:00
#   0 7 1 * *     the 1st of every month at 07:00
SCHEDULE=0 8 * * 1-5
TIMEZONE=Europe/London

# How far back each run looks for signals. Match it to your schedule: 1 for daily, 7 for weekly, 31 for monthly.
WINDOW_DAYS=7

# Hard cap per weekly run, in US cents (500 = $5). The run stops if it reaches this.
RUN_BUDGET_CENTS=500

# Optional: connect Otto (otto-pilot.io) for verified people at each account with a signal.
# In Otto: Settings → Integrations → AI assistants gives you the connector URL and an API key.
# Leave both empty to run on public web data only. Only Otto's free tools are switched on.
OTTO_MCP_URL=
OTTO_API_KEY=
